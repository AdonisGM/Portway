# SSH test server with systemd as PID 1 (Debian 12), for Portway's services
# and scheduled tasks screens. Needs privileged + the host cgroup namespace
# (see compose.yml).
FROM debian:12
ENV container=docker

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus openssh-server sudo procps ca-certificates cron nginx-light redis-server \
 && useradd -m -s /bin/bash -G sudo deploy && echo 'deploy:portway' | chpasswd \
 && useradd -m -s /bin/bash viewer && echo 'viewer:portway' | chpasswd \
 && systemctl mask getty@tty1.service console-getty.service systemd-firstboot.service

COPY sshd_portway.conf /etc/ssh/sshd_config.d/portway.conf
# Nginx sites for the Website screen: proxy + SSL, static with a certificate
# about to run out, a disabled redirect, a proxy to a port nobody listens on.
COPY systemd-nginx/ /etc/nginx/sites-available/
RUN mkdir -p /etc/ssl/portway /var/www/blog \
 && echo '<h1>blog</h1>' > /var/www/blog/index.html \
 && openssl req -x509 -newkey rsa:2048 -nodes -days 90 -subj /CN=shop.portway.test \
      -addext 'subjectAltName=DNS:shop.portway.test,DNS:www.shop.portway.test' \
      -keyout /etc/ssl/portway/shop.key -out /etc/ssl/portway/shop.crt 2>/dev/null \
 && openssl req -x509 -newkey rsa:2048 -nodes -days 10 -subj /CN=blog.portway.test \
      -keyout /etc/ssl/portway/blog.key -out /etc/ssl/portway/blog.crt 2>/dev/null \
 && chmod 600 /etc/ssl/portway/*.key \
 && for s in shop.portway.test blog.portway.test api.portway.test app-backend; do \
      ln -s /etc/nginx/sites-available/$s /etc/nginx/sites-enabled/$s; done
COPY systemd/ /etc/systemd/system/
COPY systemd/bin/ /usr/local/bin/
RUN chmod +x /usr/local/bin/* \
 && rm -rf /etc/systemd/system/bin \
 && systemctl enable portway-keys.service ssh.service nginx.service redis-server.service cron.service \
      worker-queue.service backup-db.timer cleanup-tmp.timer \
 && systemctl disable report-mailer.service \
 && echo '*/15 * * * * /usr/local/bin/sync-feeds' | crontab -u deploy - \
 && printf '0 4 * * 0 /usr/bin/apt-get clean\n30 2 * * * /usr/local/bin/rotate-uploads >> /var/log/rotate-uploads.log 2>&1\n' | crontab -u root -

STOPSIGNAL SIGRTMIN+3
EXPOSE 22
CMD ["/lib/systemd/systemd"]
