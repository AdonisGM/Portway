# Reverse proxy with SSL, HTTP redirected to HTTPS.
server {
    listen 80;
    server_name shop.portway.test www.shop.portway.test;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name shop.portway.test www.shop.portway.test;

    ssl_certificate     /etc/ssl/portway/shop.crt;
    ssl_certificate_key /etc/ssl/portway/shop.key;

    access_log /var/log/nginx/shop.access.log;
    error_log  /var/log/nginx/shop.error.log;

    gzip on;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
